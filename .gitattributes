# Everything that runs on the Linux VMs must keep LF line endings,
# even when it is edited on Windows. A CRLF in a bash script fails with
# "$'\r': command not found".
*.sh       text eol=lf
*.py       text eol=lf
*.conf     text eol=lf
*.cnf      text eol=lf
*.rules    text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.lab      text eol=lf
*.cron     text eol=lf
configs/web01/sudoers.d/*  text eol=lf
configs/mon01/logrotate.d/* text eol=lf

# Windows-side helpers keep CRLF
*.ps1      text eol=crlf

*.md       text
*.png      binary
*.jpg      binary
