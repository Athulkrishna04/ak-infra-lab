# Copy to  %USERPROFILE%\.ssh\config  on the Windows host (no file extension).
# Then `ssh web01` / `ssh mon01` / `scp file web01:` work from Windows Terminal.
# Uses your existing key ~/.ssh/id_ed25519 (build guide M0.10). Don't overwrite it with ssh-keygen.

Host mon01
    HostName 192.168.56.10
    User akadmin
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60

Host web01
    HostName 192.168.56.11
    User akadmin
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
